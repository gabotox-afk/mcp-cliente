# URL base del backend remoto
BACKEND_URL=https://facu-back.diagnostica.com.ar

# Brand ID requerido en el login
BRAND_ID=61866334643609b69b8b6v48

# JWT token de un usuario con los permisos necesarios
# Obtenerlo haciendo login en el frontend o vía POST /api/v1/user/session/login
BACKEND_TOKEN=

# Solo necesarias para correr el servidor en modo HTTP (bun src/http.ts / Docker).
# PUBLIC_URL es la URL pública real del deploy (la que anuncian los endpoints de
# discovery OAuth a clientes externos) — sin setearla, cae a http://localhost:$PORT.
# PORT=3000
# PUBLIC_URL=https://mcp.tudominio.com

# Redis donde se guardan los clients OAuth registrados (DCR) y los authorization
# codes — requerido para correr en modo HTTP con más de una réplica. Si no se
# setea, el cliente redis de Bun cae a redis://localhost:6379.
# REDIS_URL=redis://localhost:6379
