# Puerto del chat backend
CHAT_PORT=3002

# URL base del MCP server al que se conecta el chat. El brandId se agrega por
# request. Puede ser el MCP de Diagnostica o el de cualquier otra empresa.
MCP_BASE_URL=http://localhost:3001

# Credenciales de Anthropic. Sin esto el chat arranca en modo "stub": no
# interpreta lenguaje natural, pero el circuito front -> back -> MCP funciona
# igual y sirve para probar la infraestructura.
ANTHROPIC_API_KEY=

# Forzar el modo del agente: real | stub. Si se omite, usa "real" cuando hay
# API key y "stub" cuando no.
# CHAT_AGENT_MODE=stub

CHAT_MODEL=claude-sonnet-5
# Palanca de costo/latencia: low | medium | high
CHAT_EFFORT=medium

# Solo para la pagina demo: simula el login que en produccion hace la pagina de
# la empresa. En un despliegue real el token ya viene del host.
DEMO_BACKEND_URL=http://localhost:4000
DEMO_BRAND_ID=61866334643609b69b8b6c48

# Whitelist de tools que el chat puede usar, separadas por coma. Vacio o sin
# setear = todas las que exponga el MCP.
#
# Los nombres de abajo son los del MCP de Diagnostica. Lo unico que queda
# afuera es list_brands: es cross-brand, pide el rol mcp_inspector y no aplica
# a un chat de una sola marca.
#
# Las tools de usuarios SI estan: sin ellas el modelo no tiene forma de listar
# profesionales, y ante "listame los medicos" completaba la lista con nombres
# inventados a partir de lo que hubiera visto en atenciones. Los nombres del
# personal no son sensibles —el MCP solo anonimiza las cuentas ligadas a un
# paciente— asi que bloquearlas no protegia nada y si degradaba las respuestas.
#
# list_valid_filters SI tiene que estar: sin ella el modelo no tiene forma de
# chequear los valores reales de un filtro (un estado, un tipo) antes de usarlo,
# y una consulta con un valor mal escrito devuelve 0 resultados que el modelo
# puede llegar a tomar como una respuesta negativa real en vez de sospechar del
# filtro.
#
# get_operational_status y get_period_summary tambien tienen que estar: son las
# tools pensadas para que el modelo detecte problemas sin que se lo pidan
# explicitamente (kioscos caidos, atenciones estancadas, turnos vencidos) y para
# resumenes de periodo con desglose por estado/tipo -- sin ellas el chat no tiene
# forma de responder algo como "hay algo raro en la operacion ahora mismo?".
#
# Contra otro MCP hay que cambiar esta lista o dejarla vacia.
CHAT_ALLOWED_TOOLS=list_valid_filters,get_operational_status,get_period_summary,count_users,list_users,get_user,list_roles,count_sessions,list_sessions,count_attentions,list_attentions,count_appointments,list_appointments,count_exams,list_exams,count_patients,list_patients,get_patient,count_checks,list_checks,count_shared_checks,list_shared_checks,count_kiosks,list_kiosks,count_schedules,list_schedules,count_videovisits,list_videovisits,count_records,list_records

# Tope de consultas por minuto y por usuario. 0 = sin limite.
# Existen porque cada mensaje del chat es una llamada paga a la API de Claude.
# Los graficos y el resumen no pasan por el modelo, por eso tienen mas cupo.
CHAT_RATE_CHAT_PER_MIN=15
CHAT_RATE_DATA_PER_MIN=60

# Origenes autorizados a embeber el widget y a pasarle el token del usuario,
# separados por coma. Vacio = cualquiera, que sirve para desarrollo pero NO para
# produccion: el token viaja por postMessage y sin allowlist se le entrega a
# cualquier pagina que logre montar el iframe.
# CHAT_ALLOWED_ORIGINS=https://app.diagnostica.com
