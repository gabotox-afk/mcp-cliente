PORT=5000
ANTHROPIC_API_KEY=

# MCP de mcp-diagnostica corriendo con transporte HTTP (bun run http ahi)
MCP_HTTP_URL=http://localhost:3000

# Backend mock (para el /demo-login, que simula que el usuario ya esta logueado en Diagnostica)
MOCK_SERVER_URL=http://localhost:4000
DEFAULT_BRAND_ID=diagnostica

# Rango de fechas para los graficos precargados. Por default son los ultimos 30 dias
# reales -- descomentar esto solo para la demo, porque el seed de mock-server tiene
# datos fechados entre enero y junio 2026, no en fechas actuales.
# DASHBOARD_FROM=2026-01-01
# DASHBOARD_TO=2026-06-25
