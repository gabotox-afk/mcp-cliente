# Puerto del chat backend
CHAT_PORT=3002

# URL base del MCP server al que se conecta el chat. El brandId se agrega por
# request. Puede ser el MCP de Diagnostica o el de cualquier otra empresa.
MCP_BASE_URL=http://localhost:3001

# Credenciales de Anthropic. Sin esto el chat arranca en modo "stub": no
# interpreta lenguaje natural, pero el circuito front -> back -> MCP funciona
# igual y sirve para probar la infraestructura.
ANTHROPIC_API_KEY=

# Forzar el modo del agente: real | stub. Si se omite, usa "real" cuando hay
# API key y "stub" cuando no.
# CHAT_AGENT_MODE=stub

CHAT_MODEL=claude-sonnet-5
# Palanca de costo/latencia: low | medium | high
CHAT_EFFORT=medium

# Solo para la pagina demo: simula el login que en produccion hace la pagina de
# la empresa. En un despliegue real el token ya viene del host.
DEMO_BACKEND_URL=http://localhost:4000
DEMO_BRAND_ID=61866334643609b69b8b6c48

# Whitelist de tools que el chat puede usar, separadas por coma. Vacio o sin
# setear = todas las que exponga el MCP.
#
# Los nombres de abajo son los del MCP de Diagnostica. Quedan afuera a
# proposito: list_brands (cross-brand, requiere el rol mcp_inspector y no
# aplica a un chat de una sola marca), list_users / count_users / get_user
# (directorio de staff) y list_roles (catalogo interno, poco valor para el
# usuario final).
#
# Contra otro MCP hay que cambiar esta lista o dejarla vacia.
CHAT_ALLOWED_TOOLS=count_sessions,list_sessions,count_attentions,list_attentions,count_appointments,list_appointments,count_exams,list_exams,count_patients,list_patients,get_patient,count_checks,list_checks,count_shared_checks,list_shared_checks,count_kiosks,list_kiosks,count_schedules,list_schedules,count_videovisits,list_videovisits,count_records,list_records
