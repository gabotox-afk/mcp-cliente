# Puerto del chat backend
CHAT_PORT=3002

# URL base del MCP server al que se conecta el chat. El brandId se agrega por
# request. Puede ser el MCP de Diagnostica o el de cualquier otra empresa.
MCP_BASE_URL=http://localhost:3001

# Credenciales de Anthropic. Sin esto el chat arranca en modo "stub": no
# interpreta lenguaje natural, pero el circuito front -> back -> MCP funciona
# igual y sirve para probar la infraestructura.
ANTHROPIC_API_KEY=

# Forzar el modo del agente: real | stub. Si se omite, usa "real" cuando hay
# API key y "stub" cuando no.
# CHAT_AGENT_MODE=stub

CHAT_MODEL=claude-sonnet-5
# Palanca de costo/latencia: low | medium | high
CHAT_EFFORT=medium

# Solo para la pagina demo: simula el login que en produccion hace la pagina de
# la empresa. En un despliegue real el token ya viene del host.
DEMO_BACKEND_URL=http://localhost:4000
DEMO_BRAND_ID=61866334643609b69b8b6c48
